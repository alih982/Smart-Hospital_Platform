# ============================================
# AI SERVICE - تنظیمات محیطی
# ============================================
# این فایل را کپی کنید به .env
# cp .env.example .env

# ── سرویس ──
SERVICE_NAME=Smart Health AI Service
DEBUG=false

# ── مدل ──
# مسیر فایل GGUF مدل
BASE_MODEL_PATH=app/ai_model/zhaav-gemma3-4B-001.gguf
MODEL_NAME=Zhaav Gemma 3 4B (GGUF)

# ── تنظیمات inference ──
TEMPERATURE=0.7
TOP_P=0.9
MAX_NEW_TOKENS=256
MAX_INPUT_TOKENS=4096
DO_SAMPLE=true

# ── تنظیمات llama-cpp (CPU-friendly) ──
N_CTX=1024
N_THREADS=2
N_GPU_LAYERS=0

# ── RAG ──
ENABLE_RAG=false

# ── PostgreSQL Database ──
# اگر این متغیر خالی باشد، از فایل JSON محلی استفاده می‌شود
# برای فعال کردن PostgreSQL، مقدار زیر را تنظیم کنید:
# DB_URL=postgresql+psycopg2://user:password@localhost:5432/ai_service
DB_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ── pgvector (اختیاری - برای RAG در آینده) ──
ENABLE_PGVECTOR=false
VECTOR_DIMENSION=768

# ── CORS ──
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5000"]
