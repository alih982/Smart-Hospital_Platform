# ============================================
# AI SERVICE - ENV for Ubuntu 26 National Datacenter
# ============================================
SERVICE_NAME=Smart Health AI Service
DEBUG=false
BASE_MODEL_PATH=app/ai_model/zhaav-gemma3-4B-001.gguf
MODEL_NAME=Zhaav Gemma 3 4B (GGUF)

# CPU Settings (no GPU, no overheating)
N_THREADS=2
N_GPU_LAYERS=0
N_CTX=1024
TEMPERATURE=0.7
MAX_NEW_TOKENS=256
DO_SAMPLE=true

# Database - empty = local JSON files (no PostgreSQL needed)
DB_URL=

# RAG - disabled by default
ENABLE_RAG=false
ENABLE_PGVECTOR=false

# CORS - allow frontend access
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5000"]
