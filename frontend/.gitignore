cat > .gitignore << 'EOF'
# Python
venv/
.venv/
**/venv/
**/.venv/
__pycache__/
*.pyc
*.pyo

# Node
node_modules/
**/node_modules/
.next/
**/.next/

# AI Models
ai_service/ai_model/
ai_service/app/ai_model/
**/ai_model/
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# Env
.env
.env.local
.env.local.backup.*
**/.env.local

# OS
.DS_Store
**/.DS_Store
EOF